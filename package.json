{
  "name": "ai-catchup",
  "version": "1.0.0",
  "description": "Terminal-based CLI for curated AI news from premium sources",
  "main": "src/index.js",
  "type": "module",
  "bin": {
    "ai-catchup": "./bin/ai-news.js"
  },
  "scripts": {
    "build": "esbuild src/index.js --bundle --platform=node --format=esm --outdir=dist --entry-names=index --loader:.js=jsx --loader:.wasm=file --banner:js=\"import { createRequire as __createRequire } from 'module'; const require = __createRequire(import.meta.url);\" && cp node_modules/yoga-wasm-web/dist/yoga.wasm dist/yoga.wasm",
    "start": "npm run build && node dist/index.js",
    "dev": "npm run build && node dist/index.js",
    "prepare": "npm run build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\""
  },
  "keywords": [
    "ai",
    "news",
    "cli",
    "terminal",
    "developer-tools"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.5",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "conf": "^12.0.0",
    "date-fns": "^3.0.6",
    "ink": "^4.4.1",
    "ink-spinner": "^5.0.0",
    "node-cache": "^5.1.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/eslint-parser": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@vitest/ui": "^4.0.16",
    "esbuild": "^0.19.11",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "prettier": "^3.1.1",
    "react-devtools-core": "^4.28.5",
    "vitest": "^4.0.16"
  }
}
