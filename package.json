{
  "name": "ai-catchup",
  "version": "2.0.0",
  "description": "Beautiful terminal-based CLI for curated AI news from premium sources",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ai-catchup": "./dist/cli.js"
  },
  "scripts": {
    "build": "bun build ./src/cli.tsx --outdir ./dist --target bun --sourcemap=external && bun build ./src/index.ts --outdir ./dist --target bun --sourcemap=external",
    "build:types": "tsc --emitDeclarationOnly --declaration --outDir dist",
    "typecheck": "tsc --noEmit",
    "dev": "bun run ./src/cli.tsx",
    "start": "bun run build && node dist/cli.js",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\""
  },
  "keywords": [
    "ai",
    "news",
    "cli",
    "terminal",
    "tui",
    "opentui",
    "developer-tools"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/ai-catchup.git"
  },
  "packageManager": "bun@1.2.17",
  "engines": {
    "bun": ">=1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/bun": "^1.2.3",
    "@types/node": "^25.0.6",
    "@types/react": "^19.2.8",
    "eslint": "^9.39.2",
    "prettier": "^3.1.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@opentui/core": "^0.1.72",
    "@opentui/react": "^0.1.72",
    "axios": "^1.13.2",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "date-fns": "^3.0.6",
    "react": "^19.2.3",
    "rss-parser": "^3.13.0",
    "smol-toml": "^1.6.0",
    "zod": "^4.3.5"
  }
}
